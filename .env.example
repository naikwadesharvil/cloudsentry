# ====================================================================
# CloudSentry Environment Configuration
# ====================================================================
# Note: CloudSentry operates fully offline with deterministic heuristic
# engines if no LLM API keys are provided.
#
# To enable real LLM structured reasoning, provide at least one API key below:

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=
# Alternatively: GOOGLE_API_KEY=

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=

# Model overrides (Optional)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
